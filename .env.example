# ─────────────────────────────────────────────────────────────────────────────
# AMPLIFY Portable — environment template
#
# Copy to `.env.local` (web app) and `server/.env` (Docker stack) and fill in.
# Never commit the filled-in copies: every name below whose value is a secret
# is marked, and the repository's .gitignore keeps `.env*` out of git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Host ─────────────────────────────────────────────────────────────────────
# The address the browser and the agents reach this deployment at. For a LAN
# deployment this is the machine's IP; for a server, its hostname.
NODE_IP=192.168.1.10
NEXT_PUBLIC_NODE_IP=${NODE_IP}

# Public URL of the web app, used in invitation links and QR codes.
NEXT_PUBLIC_APP_URL=https://${NODE_IP}
APP_BASE_URL=https://${NODE_IP}

# ── LiveKit ──────────────────────────────────────────────────────────────────
# What the browser connects to (through the nginx proxy) and what the server
# side and the Python agents connect to.
NEXT_PUBLIC_LIVEKIT_URL=wss://${NODE_IP}/live
LIVEKIT_URL=ws://${NODE_IP}:7880

# SECRET. Must match server/server.yaml. Generate a fresh pair per deployment:
#   docker run --rm livekit/livekit-server generate-keys
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# SECRET. Redis is shared by LiveKit and its ingress. Generate with:
#   openssl rand -base64 24
# This value is passed to the redis container as --requirepass, so it is the
# only place the password is set for redis and the ingress. LiveKit is the
# exception: its own config file cannot read environment variables, so the
# SAME value must also be written into the `redis: password:` field of
# server/server.yaml by hand. If the two disagree, redis comes up fine and
# LiveKit fails to reach it at runtime.
REDIS_PASSWORD=

# ── Database ─────────────────────────────────────────────────────────────────
# MongoDB (Prisma). The Docker stack provides one as the `mongo` service.
#
# SECRET, all three. Generate the passwords as HEX, not base64: they go inside
# DATABASE_URL, where base64's `/`, `+` and `=` would have to be URL-encoded.
#   openssl rand -hex 24
# The two passwords are read ONCE, when server/data1 is empty, to create the
# users. Changing them here later does not change them in the database — see
# docs/deployment.md, "Rotating the Mongo credentials".
MONGO_ADMIN_PASSWORD=
MONGO_APP_PASSWORD=
# The replica-set keyfile, on one line. Anyone holding it has full access to
# the database, so it is a secret like the passwords:
#   openssl rand -base64 756 | tr -d '\n'
MONGO_REPLICA_KEY=
# The web app runs on the host network, so Mongo is `localhost` (not `mongo`),
# and the user is `nextauth` in the `mydb` database. Write MONGO_APP_PASSWORD
# into it literally.
DATABASE_URL=mongodb://nextauth:<MONGO_APP_PASSWORD>@localhost:27017/mydb?authSource=mydb&replicaSet=rs0&directConnection=true

# ── Authentication (NextAuth) ────────────────────────────────────────────────
NEXTAUTH_URL=https://${NODE_IP}
# SECRET. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# SECRET. Signs the session invitation links. Generate the same way.
INVITE_JWT_SECRET=

# OAuth providers — SECRET. Leave blank to disable a provider.
GOOGLE_ID=
GOOGLE_SECRET=
GITHUB_ID=
GITHUB_SECRET=

# The account granted the admin pages (/admin).
ADMIN_EMAIL=you@example.org

# ── Python agents ────────────────────────────────────────────────────────────
# The ONNX audio classifiers behind the assistant: four models per audio track,
# so this is the setting to turn off on a small machine.
ENABLE_ONNX_AUDIO_ANALYSIS=false
# MediaPipe pose/gaze and hand tracking.
ENABLE_VIDEO_PROCESSING=false
# Per-window audio event logging, for debugging the assistant.
ENABLE_AUDIO_EVENT_LOG=false
