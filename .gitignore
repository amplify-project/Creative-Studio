# NOTE: "./server/.env" never matched anything — a leading "./" is not a valid
# gitignore pattern. The .env files are tracked anyway, so ignoring them here
# would have no effect: gitignore does not apply to files already in the index.
server/.env
/server/agents/.venv
/server/agents/dataCollection/__pycache__
**/__pycache__/
*.pyc

# Node / Next build output. These were untracked but NOT ignored, so a stray
# `git add -A` staged them; unstaging left the blobs behind as unreachable
# objects (280 MB of them by 2026-07-17).
/node_modules
/.next
/out
*.tsbuildinfo
next-env.d.ts

# Local MongoDB data directory (docker volume), not source.
/server/data1
/server/agents/speechAnalysis/data

# LiveKit's own config. It must hold the real API key pair and the redis
# password, and LiveKit does NOT expand ${VAR} inside it, so there is no way to
# keep the secrets out of the file itself. Tracking it is how they were
# committed in the first place: copy server.yaml.example instead.
server/server.yaml

# Environment files: never commit a filled-in copy — use .env.example.
.env
.env.*
!.env.example

# TLS material and LiveKit keys are per deployment, not source.
certs/
server/nginx/certs/
# Let's Encrypt state, written by the certbot container: holds the live
# private key. Never source.
server/certbot/
server/livekit.key
server/livekit.crt

# Rendered from nginx/templates/nginx.conf.template by the nginx container at
# start; it is not source and must not be tracked.
server/nginx/nginx.conf

# Session data written by the agents at runtime, not source.
server/agents/dataCollection/data/

# Local audio/test material. These used to live only in `.git/info/exclude`,
# which is per-clone and does NOT travel: a fresh clone or a new remote would
# have picked them up on the next `git add -A`. Some carry a real participant's
# name in the filename, and one is a copyrighted rip.
*.wav
*.ogg
*.webm
*.aup
/tests/
/reference_data/
/test.py

# The agent guidance file is local working material, not a deliverable. It was
# only in `.git/info/exclude`, which does not survive a new clone or remote.
CLAUDE.md

# Third-party ONNX weights, 97 MB, fetched by scripts/fetch-models.sh. They are
# YAMNet (Google, Apache-2.0) and the Descript Audio Codec encoder (MIT); they
# are not ours to redistribute inside a GPLv3 source tree, and dac_encoder.onnx
# alone is over GitHub's 50 MB warning. The two in-house MLPs next to them stay
# tracked: nothing public can reproduce those.
/server/agents/assistantHost/audioAnalysis/yamnet_model.onnx
/server/agents/assistantHost/audioAnalysis/dac_encoder.onnx

# Was tracked until 2026-10; now generated per install into server/.env.
server/mongo/mongo-keyfile
